# ─────────────────────────────────────────────────────────────
# OneKitApp environment configuration
# Copy this file to `.env` and fill in the values for local dev.
# On Railway, set these as service variables instead.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# On Railway this is provided automatically by the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onekit

# Set to "true" when connecting to a managed Postgres that requires SSL
# (Railway's public proxy does). Leave "false" for local dev.
PGSSL=false

# Port the web server listens on (Railway injects PORT automatically).
PORT=3000

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the site (used for sitemap.xml, canonical URLs, schema.org).
SITE_URL=https://www.onekitapp.com

# ── Seed admin user ──
# Used by `npm run seed` to create the first admin account.
# Provide EITHER a plaintext password (hashed automatically on seed)
# OR a pre-computed bcrypt hash.
ADMIN_EMAIL=admin@onekitapp.com
ADMIN_PASSWORD=change-me-now
# ADMIN_PASSWORD_HASH=$2a$10$....

# ── Google AdSense ──
# Your AdSense publisher id, e.g. ca-pub-1234567890123456.
# Leave blank until approved; ad slots render as empty placeholders.
ADSENSE_CLIENT=

# ── Auto-seed ──
# On boot, if the tools table is empty, the app loads the built-in catalog
# automatically (no manual `npm run seed` needed). Set to false to disable.
AUTO_SEED=true
# Force a catalog re-import (upsert) on the next boot even if tools exist.
# Set to true once, deploy, then set back to false.
RESEED_ON_BOOT=false

# ── Auto-discovery cron ──
# Enable the scheduled tool-discovery job (writes candidates to the
# review queue). Off by default so local dev doesn't hit the network.
DISCOVERY_ENABLED=false
# Cron schedule (default: 07:00 UTC daily).
DISCOVERY_CRON=0 7 * * *
