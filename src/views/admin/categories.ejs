<%- include('partials/top') %>
  <div class="admin-head">
    <h1>Categories</h1>
    <a class="btn btn-primary" href="/admin/categories/new">+ Add category</a>
  </div>

  <% if (flash) { %><div class="alert alert-success"><%= flash %></div><% } %>

  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Order</th><th>Name</th><th>Slug</th><th>Tools</th><th></th></tr></thead>
      <tbody>
        <% categories.forEach(function (c) { %>
          <tr>
            <td><%= c.sort_order %></td>
            <td><strong><%= c.name %></strong><br><span class="faint" style="font-size:0.8rem;"><%= c.description %></span></td>
            <td class="muted">/category/<%= c.slug %></td>
            <td><%= c.tool_count || 0 %></td>
            <td class="actions">
              <a class="btn btn-ghost btn-sm" href="/admin/categories/<%= c.id %>/edit">Edit</a>
              <form action="/admin/categories/<%= c.id %>/delete" method="post" class="inline-form" onsubmit="return confirm('Delete this category? Its tools will be left uncategorised.');">
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<%- include('partials/bottom') %>
