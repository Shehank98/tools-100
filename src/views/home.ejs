<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <!-- HERO + SEARCH -->
  <section class="hero">
    <div class="container">
      <h1>Every online tool, in one place</h1>
      <p class="lead">A hand-curated directory of the best free tools for PDFs, images, text, code, SEO and more. No signup, no clutter.</p>

      <div class="search" data-search>
        <input type="search" id="q" placeholder="Search tools, e.g. pdf to jpg, compress image, word counter"
               autocomplete="off" aria-label="Search tools" data-search-input />
        <div class="search-results" data-search-results role="listbox"></div>
        <p class="search-hint">Popular: <a href="/search?q=pdf">PDF</a>, <a href="/search?q=image">Image</a>, <a href="/search?q=converter">Converter</a>, <a href="/search?q=password">Password</a></p>
      </div>

      <p class="hero-stats"><%= totalTools %> tools across <%= totalCategories %> categories</p>
    </div>
  </section>

  <!-- CATEGORY QUICK-NAV -->
  <nav class="cat-quicknav" aria-label="Tool categories">
    <div class="container">
      <div class="track">
        <% groups.forEach(function (g) { %>
          <a href="#<%= g.category.slug %>"><%= g.category.name %></a>
        <% }); %>
      </div>
    </div>
  </nav>

  <!-- HEADER BANNER AD (below nav, never above search) -->
  <div class="container">
    <%- include('partials/ad', { variant: 'banner', slotId: '' }) %>
  </div>

  <!-- DIRECTORY: every category with its tools -->
  <div class="container" id="categories">
    <% groups.forEach(function (g, gi) { %>
      <section class="dir-block" id="<%= g.category.slug %>">
        <div class="dir-head">
          <h2><%= g.category.name %></h2>
          <a href="/category/<%= g.category.slug %>">View all <%= g.tools.length %></a>
        </div>
        <p class="dir-desc"><%= g.category.description %></p>
        <div class="tool-grid">
          <% g.tools.forEach(function (tool) { %>
            <%- include('partials/tool-card', { tool: tool, hideCat: true }) %>
          <% }); %>
        </div>
      </section>
      <% if (gi === 2) { %><%- include('partials/ad', { variant: 'infeed', slotId: '' }) %><% } %>
    <% }); %>
  </div>
</main>

<%- include('partials/footer') %>
