<%
  var showCat = !(typeof hideCat !== 'undefined' && hideCat);
%>
<article class="tool-card">
  <% if (showCat) { %><span class="tool-cat"><%= tool.category_name || 'Tool' %></span><% } %>
  <h3><a href="/tool/<%= tool.slug %>"><%= tool.name %></a></h3>
  <p class="desc"><%= tool.description %></p>
  <div class="tool-foot">
    <div>
      <% if (tool.is_featured) { %><span class="badge badge-featured">Featured</span><% } %>
    </div>
    <a class="tool-open" href="/go/<%= tool.slug %>" rel="nofollow noopener" target="_blank">Open</a>
  </div>
</article>
