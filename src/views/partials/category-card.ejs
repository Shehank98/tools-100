<a class="tool-card" href="/category/<%= category.slug %>">
  <span class="tool-cat"><%= category.tool_count || 0 %> tool<%= Number(category.tool_count) === 1 ? '' : 's' %></span>
  <h3><%= category.name %></h3>
  <p class="desc"><%= category.description %></p>
  <div class="tool-foot"><span class="tool-open">Browse</span></div>
</a>
