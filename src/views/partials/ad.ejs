<%
  // Reusable ad slot. Renders a real AdSense unit only when a publisher id
  // AND a slot id are configured. Until then it renders nothing at all, so
  // there are no empty "Advertisement" placeholders on the live site.
  var variant = variant || 'banner';
  var slotId = slotId || '';
  var cls = variant === 'sidebar' ? 'ad-slot--sidebar' : (variant === 'infeed' ? 'ad-slot--infeed' : '');
%>
<% if (adsenseClient && slotId) { %>
<div class="ad-slot <%= cls %>" aria-label="Advertisement" role="complementary">
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="<%= adsenseClient %>"
       data-ad-slot="<%= slotId %>"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>
<% } %>
