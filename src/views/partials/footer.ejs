<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">One<b>Kit</b></a>
        <p><%= siteTagline %> A hand-curated, always-growing directory of the best free online tools.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <a href="/">Home</a>
        <a href="/#categories">All Tools</a>
        <a href="/submit">Submit a Tool</a>
      </div>
      <div>
        <h4>Company</h4>
        <a href="/about">About</a>
        <a href="/about#contact">Contact</a>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
      <div>
        <h4>Legal</h4>
        <a href="/privacy">Privacy Policy</a>
        <a href="/privacy#cookies">Cookie Policy</a>
        <a href="/privacy#terms">Terms of Use</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; <%= year %> <%= siteName %>. All rights reserved.</span>
      <span>Free online tools, in one place.</span>
    </div>
  </div>
</footer>

<!-- Cookie consent (required for AdSense + GDPR) -->
<div class="cookie-banner" data-cookie-banner hidden>
  <p>We use cookies to remember your preferences and, once ads are enabled, to personalise them. See our <a href="/privacy#cookies">Cookie Policy</a>.</p>
  <div class="cookie-actions">
    <button class="btn btn-ghost btn-sm" data-cookie-decline>Decline</button>
    <button class="btn btn-primary btn-sm" data-cookie-accept>Accept</button>
  </div>
</div>

<script src="/js/main.js" defer></script>
</body>
</html>
